#ifndef WIZBUILDIDENTITY_H
#define WIZBUILDIDENTITY_H

#include <QGuiApplication>
#include <QString>

namespace WizBuildIdentity {
constexpr bool appleSiliconTrial = @WIZNOTE_APPLE_SILICON_TRIAL@ != 0;
// Personal-use port: keep existing group notes/sync, not legacy web administration.
constexpr bool groupAdministrationEnabled = !appleSiliconTrial;
inline QString displayName() { return QStringLiteral("@WIZNOTE_MAC_DISPLAY_NAME@"); }
inline QString trialBuild() { return QStringLiteral("@WIZNOTE_COMPAT_TRIAL_BUILD@"); }
inline QString appVersion() { return QStringLiteral("@WIZNOTE_MAC_BUNDLE_BUILD@"); }
inline QString organizationName() { return QStringLiteral("@WIZNOTE_MAC_BUNDLE_ID@"); }
// v14.3 deliberately isolates the organization identity. Existing explicit
// per-user INI files retain their keys/content; no applicationName-based move.
inline void applyDisplayName() { QGuiApplication::setApplicationDisplayName(displayName()); }
}

#endif
