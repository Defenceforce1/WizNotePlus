# Compile exact current routing bodies with a synthetic shell; never construct
# the normal main window, downloader, account, editor or network collaborator.
set(routing_source "${CMAKE_CURRENT_SOURCE_DIR}/gui/documentviewer/WizDocumentView.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${routing_source}")
file(READ "${routing_source}" routing_text)
string(REPLACE "\r\n" "\n" routing_text "${routing_text}")
set(routing_bodies "")
function(wiz_extract_routing begin_marker end_marker)
    string(FIND "${routing_text}" "${begin_marker}" begin)
    string(FIND "${routing_text}" "${end_marker}" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Document routing boundaries changed: ${begin_marker}")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${routing_text}" ${begin} ${length} body)
    string(REPLACE "WizDocumentView" "RoutingView" body "${body}")
    set(routing_bodies "${routing_bodies}\n${body}" PARENT_SCOPE)
endfunction()
