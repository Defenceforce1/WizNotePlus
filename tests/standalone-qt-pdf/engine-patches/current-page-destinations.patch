+TEST_P(PrintContextTest, LinkedTargetUsesCurrentPageContentTransform) {
+  struct Scenario {
+    int width;
+    float margin;
+    float scale;
+  };
+  const Scenario scenarios[] = {
+      {400, 20, 1}, {1200, 20, 1}, {1200, 40, 1},
+      {400, 20, .75f}, {1200, 20, 1.25f}};
+  for (const auto& scenario : scenarios) {
+    SCOPED_TRACE(testing::Message() << scenario.width << " " << scenario.margin
+                                  << " " << scenario.scale);
+    StringBuilder html;
+    html << "<style>body{width:" << scenario.width
+         << "px}article{break-before:page;padding-top:100px}"
+            "a{display:block;width:80px;height:30px;margin-left:40px}"
+            "</style><article><a id='one' href='#one'>one</a></article>"
+            "<article><a id='two' href='#two'>two</a></article>";
+    SetBodyInnerHTML(html.ReleaseString());
+    WebPrintParams params(gfx::SizeF(kPageWidth, kPageHeight));
+    params.default_page_description.margin_top = scenario.margin;
+    params.default_page_description.margin_left = scenario.margin + 10;
+    params.default_page_description.margin_right = scenario.margin;
+    params.default_page_description.margin_bottom = scenario.margin + 5;
+    params.scale_factor = scenario.scale;
+    params.ignore_css_margins = true;
+    for (int page_index = 0; page_index < 2; ++page_index) {
+      SCOPED_TRACE(page_index);
+      testing::NiceMock<MockPageContextCanvas> canvas;
+      PrintSinglePage(canvas, page_index, &params);
+      const std::string name = page_index ? "two" : "one";
+      const MockPageContextCanvas::Operation* source = nullptr;
+      const MockPageContextCanvas::Operation* destination = nullptr;
+      for (const auto& operation : canvas.RecordedOperations()) {
+        if (operation.destination != name)
+          continue;
+        if (operation.type == MockPageContextCanvas::kDrawPoint) {
+          ASSERT_FALSE(destination);
+          destination = &operation;
+        } else {
+          ASSERT_FALSE(source);
+          source = &operation;
+        }
+      }
+      ASSERT_TRUE(source);
+      ASSERT_TRUE(destination);
+      EXPECT_NEAR(destination->rect.x(), source->rect.x(), 1);
+      EXPECT_NEAR(destination->rect.y(), source->rect.y(), 1);
+    }
+  }
+}
