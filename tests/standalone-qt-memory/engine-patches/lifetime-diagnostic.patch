+            qCDebug(lcWebEngineCompositor, "WizMetalLifetime wrapper-destroyed native=%p", native);
+        });
+    }
+    return wrapped;
 }
 
 void releaseMetalTexture(void *texture)
 {
+    if (qEnvironmentVariableIsSet("WIZNOTE_METAL_LIFETIME_DIAGNOSTIC"))
+        qCDebug(lcWebEngineCompositor, "WizMetalLifetime release native=%p", texture);
     [static_cast<id<MTLTexture>>(texture) release];
 }
 
