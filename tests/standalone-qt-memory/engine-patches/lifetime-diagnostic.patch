-    return QNativeInterface::QSGMetalTexture::fromNative(texture, win, size, texOpts);
+    auto *wrapped = QNativeInterface::QSGMetalTexture::fromNative(texture, win, size, texOpts);
+    if (qEnvironmentVariableIsSet("WIZNOTE_METAL_LIFETIME_DIAGNOSTIC")) {
+        const auto native = static_cast<void *>(texture);
