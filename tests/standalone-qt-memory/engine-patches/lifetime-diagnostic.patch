@@ -16,6 +16,7 @@
 #include <QtQuick/qquickwindow.h>
 #include <QtQuick/qsgrendererinterface.h>
 #include <QtQuick/qsgtexture.h>
+#include "compositor.h"
 
 #if QT_CONFIG(opengl)
 #include <OpenGL/OpenGL.h>
@@ -40,11 +41,22 @@
     id<MTLTexture> texture = [device newTextureWithDescriptor:desc
                                                     iosurface:ioSurface
